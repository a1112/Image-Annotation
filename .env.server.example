# Generate independent values with at least 32 random bytes. Do not commit real tokens.
IMAGE_ANNOTATION_ADMIN_TOKEN=
IMAGE_ANNOTATION_EDITOR_TOKEN=
IMAGE_ANNOTATION_READER_TOKEN=

# Comma-separated browser origins. Wildcards are rejected.
IMAGE_ANNOTATION_ALLOWED_ORIGINS=http://127.0.0.1:1440
IMAGE_ANNOTATION_MAX_UPLOAD_MIB=2048
RUST_LOG=image_annotation=info,tower_http=info
