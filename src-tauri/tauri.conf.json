{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Image Annotation",
  "version": "0.1.0",
  "identifier": "com.imageannotation.desktop",
  "build": {
    "beforeDevCommand": "npm exec vite -- --host 127.0.0.1 --port 1440",
    "devUrl": "http://localhost:1440",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Image Annotation",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "transparent": true,
        "decorations": false,
        "shadow": true,
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["../data/test_data/**", "../data/workspaces/**", "**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
